---
// Hidden in markup and revealed by its own script: a theme toggle cannot work
// without JavaScript, so a no-JS visitor should never see a dead control.
---
<button type="button" id="theme-toggle" class="theme-toggle" aria-pressed="true" hidden>
  <span aria-hidden="true" class="theme-toggle__icon"></span>
  <span class="theme-toggle__text">Dark mode</span>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  if (btn) {
    btn.hidden = false;
    const sync = () => {
      const isDark = document.documentElement.dataset.theme !== 'light';
      btn.setAttribute('aria-pressed', String(isDark));
    };
    sync();
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode, blocked storage — the toggle still works for this page */
      }
      sync();
    });
  }
</script>
